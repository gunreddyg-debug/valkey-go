+	t.Run("MaxSlotWait while the refresh hangs", func(t *testing.T) {
+		m := newSWCluster(swFailingOver)
+		client := newSWClient(t, m, ClusterOption{MaxSlotWait: timeout})
+		release := m.holdShards()
