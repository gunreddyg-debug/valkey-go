+		client := newSWClient(t, m, ClusterOption{MaxSlotWait: 5 * time.Second})
+		release := m.holdShards()
+		defer release()
+		start := time.Now()
+		ctx, cancel := context.WithTimeout(context.Background(), timeout)
+		defer cancel()
+		_, _, err := swGet(ctx, client, swMissingKey)
