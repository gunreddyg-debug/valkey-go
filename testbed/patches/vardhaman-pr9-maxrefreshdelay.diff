 func clusterClientWithConnCount(n int) *clusterClient {
 	conns := make(map[string]connrole, n)
 	for i := 0; i < n; i++ {
 		conns[fmt.Sprintf("%d", i)] = connrole{}
 	}
-	return &clusterClient{conns: conns}
+	return &clusterClient{conns: conns, opt: &ClientOption{}}
 }
 
